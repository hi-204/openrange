{
  "name": "openrange",
  "version": "0.1.0",
  "private": true,
  "description": "Offline No-Limit Hold'em study suite: solver, trainer and course.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "preview": "npm --workspace web run preview",
    "test": "npm --workspace web run test",
    "test:e2e": "npm --workspace web run test:e2e",
    "check": "node scripts/check.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "validate": "cargo run --release --locked -p solver-cli -- validate",
    "licenses": "node scripts/license-report.mjs",
    "facts": "node scripts/gen-lesson-facts.mjs",
    "screenshots": "npm --workspace web run screenshots"
  }
}
